CH_HOST=clickhouse
CH_USER=default
CH_PASSWORD=changeme
CH_DB=otel,logs

# Elasticsearch (optional; enabled when ES_URL and ES_INDICES are set)
ES_URL=https://elasticsearch:9200
ES_INDICES=logs-*,app-*
ES_API_KEY=changeme
# or: ES_USER=elastic  ES_PASSWORD=changeme
# ES_CA_CERTS=/certs/ca.crt   ES_VERIFY_CERTS=true
# DEFAULT_SOURCE=clickhouse

OLLAMA_URL=http://ollama:11434
MODEL=qwen2.5-coder:7b
MODELS=qwen2.5-coder:7b,llama3.1:8b
# optional
# SCHEMA_TTL_SECONDS=300
# DEFAULT_ROW_LIMIT=1000
# MAX_EXECUTION_TIME=30
# CONTEXT_DIR=/app/context
